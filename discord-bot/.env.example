# Copy to .env locally. On a host, put these in its private environment/secrets settings.
# NEVER commit real secrets. The Discord token exists ONLY on the bot host.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: leave empty to send pet hatches to the same channel.
DISCORD_HATCH_CHANNEL_ID=
# Generate with npm run secret; store this SAME value in Roblox Secrets.
ROBLOX_API_KEY=
# Use game.GameId / Experience ID, not game.PlaceId.
ROBLOX_UNIVERSE_ID=
NOTIFY_RARITIES=Legendary,Mythic,Mythical,Secret
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/notifications.sqlite
MAX_QUEUE_SIZE=10000
REQUESTS_PER_MINUTE=120
# Used ONLY by npm run test:notification. Set TEST_PLACE_ID to your real Place ID.
BOT_BASE_URL=http://127.0.0.1:3000
TEST_PLACE_ID=
